[
 {
  "Id": "y1_day_purpose_board",
  "Kind": "scene",
  "Conditions": [
   "flag:system_awake",
   "!flag:path_nihilist"
  ],
  "Priority": 45,
  "bOnce": true,
  "Slots": {},
  "Location": "corridor",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "A ranking board flickers. Your name sits nowhere near the top. The corridor empties except for footsteps that refuse to match yours.",
    "Shot": "wide"
   },
   {
    "Speaker": "system",
    "Text": "Notification: Purpose Survey open. Complete within 48 hours for evaluation credit.",
    "Shot": "close"
   },
   {
    "Speaker": "@ally",
    "Text": "{ally} taps the glass. \"They ask why you're here like it's homework.\"",
    "Shot": "over_shoulder"
   },
   {
    "Speaker": "@ally",
    "Text": "\"I put 'to not be average.' Felt honest. You?\"",
    "Shot": "close"
   }
  ],
  "PromptSpeaker": "@ally",
  "Text": "{ally} waits. The survey cursor blinks. What do you write?",
  "Choices": [
   {
    "Id": "purpose_friends",
    "Text": "Write: find people who matter.",
    "Requires": [],
    "Tags": {
     "empathy": 1,
     "loyalty": 0.5
    },
    "StatDeltas": {
     "Sanity.Composure": 1,
     "Charisma.Charm": 1
    },
    "SetFlags": [
     "path_friendship",
     "met_purpose_survey"
    ],
    "Next": "None"
   },
   {
    "Id": "purpose_climb",
    "Text": "Write: reach #1. Nothing else.",
    "Requires": [],
    "Tags": {
     "ambition": 1,
     "obedience": 0.5
    },
    "StatDeltas": {
     "Cunning.Tactics": 1,
     "Reputation.Standing": 1
    },
    "SetFlags": [
     "path_ratrace",
     "met_purpose_survey"
    ],
    "Next": "None"
   },
   {
    "Id": "purpose_blank",
    "Text": "Leave it blank on purpose.",
    "Requires": [],
    "Tags": {
     "withdrawal": 1,
     "chaos": 0.3
    },
    "StatDeltas": {
     "Sanity.Focus": -1,
     "Luck.Timing": 1
    },
    "SetFlags": [
     "path_blank",
     "met_purpose_survey",
     "uniq_blank_purpose"
    ],
    "Next": "None"
   },
   {
    "Id": "purpose_joke",
    "Text": "Write a joke answer.",
    "Requires": [
     "stat:Charisma>=3"
    ],
    "Tags": {
     "humor": 1,
     "chaos": 0.5
    },
    "StatDeltas": {
     "Charisma.Presence": 2,
     "Sanity.Resilience": 1
    },
    "SetFlags": [
     "path_absurdist",
     "met_purpose_survey"
    ],
    "Next": "None"
   }
  ]
 },
 {
  "Id": "y1_day_nihilist_bench",
  "Kind": "scene",
  "Conditions": [
   "flag:system_awake",
   "flag:met_purpose_survey"
  ],
  "Priority": 40,
  "bOnce": true,
  "Slots": {},
  "Location": "courtyard",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "The courtyard fountain spits grey water. Someone carved NOTHING MATTERS into a bench, then added a smiley face.",
    "Shot": "wide"
   },
   {
    "Speaker": "@ex1",
    "Text": "{ex1} sits on the carving. \"Cute. I used to believe in ladders. Then I fell off one.\"",
    "Shot": "low"
   },
   {
    "Speaker": "@ex1",
    "Text": "\"Ranks, points, purpose surveys—toys for people who need a script.\"",
    "Shot": "close"
   },
   {
    "Speaker": "@ex1",
    "Text": "\"You still chasing meaning, or did the board already hollow you out?\"",
    "Shot": "over_shoulder"
   }
  ],
  "PromptSpeaker": "@ex1",
  "Text": "{ex1} studies your face like a failed exam paper. How do you answer?",
  "Choices": [
   {
    "Id": "nihil_agree",
    "Text": "Agree: none of it matters.",
    "Requires": [],
    "Tags": {
     "withdrawal": 1,
     "honesty": 0.5
    },
    "StatDeltas": {
     "Sanity.Composure": -1,
     "Cunning.Observation": 1
    },
    "SetFlags": [
     "path_nihilist",
     "met_ex1_bench"
    ],
    "Next": "None"
   },
   {
    "Id": "nihil_reject",
    "Text": "Reject: I will invent meaning.",
    "Requires": [],
    "Tags": {
     "ambition": 0.8,
     "loyalty": 0.4
    },
    "StatDeltas": {
     "Sanity.Resilience": 2,
     "Charisma.Presence": 1
    },
    "SetFlags": [
     "path_selfmade",
     "met_ex1_bench"
    ],
    "Next": "None"
   },
   {
    "Id": "nihil_probe",
    "Text": "Ask why they fell.",
    "Requires": [
     "rel:@ex1>0"
    ],
    "Tags": {
     "empathy": 1,
     "cunning": 0.3
    },
    "StatDeltas": {
     "Intellect.Analysis": 1,
     "Sanity.Focus": 1
    },
    "SetFlags": [
     "met_ex1_story",
     "met_ex1_bench"
    ],
    "Next": "None"
   },
   {
    "Id": "nihil_mock",
    "Text": "Call them dramatic.",
    "Requires": [],
    "Tags": {
     "cruelty": 0.7,
     "humor": 0.4
    },
    "StatDeltas": {
     "Charisma.Presence": 1,
     "Reputation.Standing": -1
    },
    "SetFlags": [
     "met_ex1_bench",
     "flag_ex1_cold"
    ],
    "Next": "None"
   }
  ]
 },
 {
  "Id": "y1_day_absurdist_lunch",
  "Kind": "scene",
  "Conditions": [
   "flag:system_awake",
   "!flag:path_ratrace"
  ],
  "Priority": 35,
  "bOnce": true,
  "Slots": {},
  "Location": "cafeteria",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "The cafeteria menu lists 'Existential Stew' as sold out. Someone taped a banana to the ranking display.",
    "Shot": "wide"
   },
   {
    "Speaker": "@gremlin",
    "Text": "{gremlin} bows to the banana. \"Behold: our true class president.\"",
    "Shot": "close"
   },
   {
    "Speaker": "@president",
    "Text": "{president} pinches the bridge of their nose. \"Remove that. Now.\"",
    "Shot": "over_shoulder"
   },
   {
    "Speaker": "@gremlin",
    "Text": "\"Or we crown it and skip the election. Democracy via potassium.\"",
    "Shot": "pan"
   },
   {
    "Speaker": "system",
    "Text": "Alert: Unauthorized symbolism may affect Reputation metrics.",
    "Shot": "close"
   }
  ],
  "PromptSpeaker": "@gremlin",
  "Text": "{gremlin} offers you the banana peel like a ballot. What do you do?",
  "Choices": [
   {
    "Id": "abs_join",
    "Text": "Kneel to the banana.",
    "Requires": [],
    "Tags": {
     "chaos": 1,
     "humor": 1
    },
    "StatDeltas": {
     "Sanity.Composure": -1,
     "Luck.Fortune": 2,
     "Charisma.Charm": 1
    },
    "SetFlags": [
     "path_absurdist",
     "met_banana_cult"
    ],
    "Next": "None"
   },
   {
    "Id": "abs_side_pres",
    "Text": "Help {president} remove it.",
    "Requires": [],
    "Tags": {
     "obedience": 1,
     "loyalty": 0.5
    },
    "StatDeltas": {
     "Reputation.Standing": 2,
     "Physique.Agility": 1
    },
    "SetFlags": [
     "met_pres_favor",
     "flag_anti_chaos"
    ],
    "Next": "None"
   },
   {
    "Id": "abs_sell",
    "Text": "Auction the banana for points.",
    "Requires": [
     "stat:Funds>=2"
    ],
    "Tags": {
     "ambition": 0.8,
     "cunning": 0.7
    },
    "StatDeltas": {
     "Funds.Liquidity": 2,
     "Cunning.Tactics": 1
    },
    "SetFlags": [
     "met_points_hustle",
     "path_absurdist"
    ],
    "Next": "None"
   },
   {
    "Id": "abs_ignore",
    "Text": "Walk away eating stew.",
    "Requires": [],
    "Tags": {
     "withdrawal": 0.8
    },
    "StatDeltas": {
     "Sanity.Focus": 1,
     "Physique.Endurance": 1
    },
    "SetFlags": [
     "flag_ignored_gremlin"
    ],
    "Next": "None"
   }
  ]
 },
 {
