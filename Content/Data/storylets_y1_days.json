  "Slots": {},
  "Location": "rooftop",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "Wind scrapes the rooftop fence. Below, class colours blur into one grey herd.",
    "Shot": "wide"
   },
   {
    "Speaker": "@ally",
    "Text": "{ally} sits on the ledge, legs swinging. \"If the System wants puppets, we can still be friends off-stage.\"",
    "Shot": "close"
   },
   {
    "Speaker": "@ally",
    "Text": "\"Or maybe friendship is just another metric. I hate that thought.\"",
    "Shot": "over_shoulder"
