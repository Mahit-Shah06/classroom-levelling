     "empathy": 1.0,
     "withdrawal": 0.5
    },
    "StatDeltas": {
     "Charisma.Warmth": 1.0,
     "Sanity.Calm": 0.5
    },
    "SetFlags": [
     "met_rival"
    ],
    "Next": "None"
   },
   {
    "Id": "rival_mock",
