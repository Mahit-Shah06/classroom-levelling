[
 {
  "Id": "y1_ceremony",
  "Kind": "scene",
  "Conditions": [],
  "Priority": 100.0,
  "bOnce": true,
  "Slots": {},
  "Location": "hall",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "The hall smells of floor wax and ambition. Five hundred new uniforms face a stage that looks like a verdict.",
    "Shot": "wide"
   },
   {
    "Speaker": "@head",
    "Text": "Welcome. Our placement rate is ninety-nine percent. The missing one percent chose poorly. Don't join them.",
    "Shot": "close"
   },
   {
    "Speaker": "@head",
    "Text": "Merit is everything. Points buy privilege; privilege buys silence. Your evaluation is always on.",
    "Shot": "over_shoulder"
   },
   {
    "Speaker": "narrator",
    "Text": "A cough in the back row tries to become a laugh and fails.",
    "Shot": "pan"
   },
   {
    "Speaker": "@gremlin",
    "Text": "Ninety-nine percent? Cool. I'm applying for the fun one percent. Do we get a badge?",
    "Shot": "low"
   },
   {
    "Speaker": "@head",
    "Text": "Humor noted. Humor scored. Sit down before your score becomes a cautionary tale.",
    "Shot": "close"
   },
   {
    "Speaker": "narrator",
    "Text": "The lights don't dim. They sharpen. Every face becomes a rank waiting to happen.",
    "Shot": "wide"
   }
  ],
  "PromptSpeaker": "@head",
  "Text": "Before you leave this hall: what do you believe this school is for?",
  "Choices": [
   {
    "Id": "ceremony_obey",
    "Text": "To become what they measure.",
    "Requires": [],
    "Tags": {
     "obedience": 1.0,
     "ambition": 0.5
    },
    "StatDeltas": {
     "Reputation.Composure": 1.0,
     "Sanity.Focus": 0.5
    },
    "SetFlags": [
     "ceremony_done"
    ],
    "Next": "y1_homeroom_app"
   },
   {
    "Id": "ceremony_study",
    "Text": "To learn how the scoring works.",
    "Requires": [],
    "Tags": {
     "cunning": 1.0,
     "ambition": 0.5
    },
    "StatDeltas": {
     "Intellect.Logic": 1.0,
     "Cunning.Insight": 0.5
    },
    "SetFlags": [
     "ceremony_done"
    ],
    "Next": "y1_homeroom_app"
   },
   {
    "Id": "ceremony_doubt",
    "Text": "To survive people, not numbers.",
    "Requires": [],
    "Tags": {
     "empathy": 1.0,
     "withdrawal": 0.5
    },
    "StatDeltas": {
     "Charisma.Empathy": 1.0,
     "Sanity.Resolve": 0.5
    },
    "SetFlags": [
     "ceremony_done"
    ],
    "Next": "y1_homeroom_app"
   },
   {
    "Id": "ceremony_chaos",
    "Text": "To make the one percent legendary.",
    "Requires": [],
    "Tags": {
     "chaos": 1.0,
     "humor": 1.0
    },
    "StatDeltas": {
     "Luck.Impulse": 1.0,
     "Charisma.Presence": 0.5
    },
    "SetFlags": [
     "ceremony_done"
    ],
    "Next": "y1_homeroom_app"
   }
  ]
 },
 {
  "Id": "y1_homeroom_app",
  "Kind": "scene",
  "Conditions": [
   "flag:ceremony_done"
  ],
  "Priority": 90.0,
  "bOnce": true,
  "Slots": {},
  "Location": "classroom",
  "Lines": [
   {
    "Speaker": "@homeroom",
    "Text": "Phones out. The evaluation app is not optional. If it pings, you answer. If it scores, you live with it.",
    "Shot": "wide"
   },
   {
    "Speaker": "@homeroom",
    "Text": "Ranks update nightly. Class points are shared blood. Bleed for yourselves or bleed for each other—your choice.",
    "Shot": "close"
   },
   {
    "Speaker": "@homeroom",
    "Text": "Every hallway glance, every joke, every silence: logged. I don't invent your numbers. I just announce them.",
    "Shot": "over_shoulder"
   },
   {
    "Speaker": "system",
    "Text": "NOTIFICATION: Profile initialized. Baseline stats locked. Observation active. First quest pending.",
    "Shot": "close"
   },
   {
    "Speaker": "narrator",
    "Text": "A soft chime. Your screen fills with bars that look like a confession written by strangers.",
    "Shot": "pan"
   }
  ],
  "PromptSpeaker": "@homeroom",
  "Text": "Your first app prompt asks how you intend to treat the evaluation. Answer carefully.",
  "Choices": [
   {
    "Id": "app_obedient",
    "Text": "Follow every directive.",
    "Requires": [],
    "Tags": {
     "obedience": 1.0,
     "loyalty": 0.5
    },
    "StatDeltas": {
     "Reputation.Discipline": 1.0,
     "Sanity.Focus": 0.5
    },
    "SetFlags": [
     "system_awake",
     "path_obedient"
    ],
    "Next": "None"
   },
   {
    "Id": "app_curious",
    "Text": "Test what it notices.",
    "Requires": [],
    "Tags": {
     "cunning": 1.0,
     "ambition": 0.5
    },
    "StatDeltas": {
     "Intellect.Analysis": 1.0,
     "Cunning.Probe": 0.5
    },
    "SetFlags": [
     "system_awake",
     "path_curious"
    ],
    "Next": "None"
   },
   {
    "Id": "app_defiant",
    "Text": "Refuse to play neat.",
    "Requires": [],
    "Tags": {
     "betrayal": 0.5,
     "chaos": 0.5
    },
    "StatDeltas": {
     "Sanity.Spite": 1.0,
     "Cunning.Defiance": 0.5
    },
    "SetFlags": [
     "system_awake",
     "path_defiant"
    ],
    "Next": "None"
   },
   {
    "Id": "app_clown",
    "Text": "Rename your stats as jokes.",
    "Requires": [],
    "Tags": {
     "humor": 1.0,
     "chaos": 1.0
    },
    "StatDeltas": {
     "Luck.Absurdity": 1.0,
     "Charisma.Wit": 0.5
    },
    "SetFlags": [
     "system_awake",
     "path_clown"
    ],
    "Next": "None"
   }
  ]
 },
 {
  "Id": "y1_meet_rival",
  "Kind": "scene",
  "Conditions": [
