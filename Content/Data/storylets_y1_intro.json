  "Location": "corridor",
  "Lines": [
   {
    "Speaker": "narrator",
    "Text": "Between lockers, {rival} is already reading last year's ranking board like a menu.",
    "Shot": "wide"
   },
   {
    "Speaker": "@rival",
    "Text": "You're in my peripheral. Don't take it personally. I track everything that might grow teeth.",
    "Shot": "close"
   },
   {
    "Speaker": "@rival",
    "Text": "If the app likes you, I dislike you. If it hates you, I study you. Either way, you're homework.",
    "Shot": "over_shoulder"
   },
   {
    "Speaker": "@rival",
    "Text": "Smile if you want allies. I prefer equations that don't smile back.",
    "Shot": "close"
   }
  ],
  "PromptSpeaker": "@rival",
  "Text": "{rival} waits—measuring your silence like a grade.",
